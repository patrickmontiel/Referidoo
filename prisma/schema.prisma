generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Advisor {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  password          String
  phone             String?
  companyName       String?
  plan              String           @default("freemium")
  emailVerified     Boolean          @default(false)
  verificationToken String?          @unique
  mpPreapprovalId   String?          @unique
  paidUntil         DateTime?
  paymentFailedAt   DateTime?
  onboardedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  clients           Client[]
  referrals         Referral[]
  tiers             RewardTier[]
  settings          AdvisorSettings?
  planEvents        PlanEvent[]
}

model AdvisorSettings {
  id                   String  @id @default(cuid())
  advisorId            String  @unique
  advisor              Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  afterLastTier        String  @default("cycle")
  flatAmount           Int     @default(1500)
  whatsappMessage      String?
  advisorInviteMessage String?
  welcomeMessage       String?
  schedulingUrl        String?
  // Credibilidad mostrada en la landing del referido (la captura el asesor en
  // /admin/perfil): credencial real (cédula), años de experiencia y personas
  // atendidas de por vida. Distinta por asesor.
  credential           String?
  yearsExperience      Int?
  peopleServed         Int?
  bubbleAutoPoints     Int     @default(150)
  bubbleGmmPoints      Int     @default(300)
  bubbleClaimThreshold Int     @default(500)
}

model RewardTier {
  id        String  @id @default(cuid())
  advisorId String
  advisor   Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  position  Int
  amount    Int
  label     String?

  @@unique([advisorId, position])
}

model Client {
  id               String     @id @default(cuid())
  advisorId        String
  advisor          Advisor    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  policyNumber     String?
  // Datos para recibir premios (el cliente los captura en su portal; el
  // asesor los ve al pagar). CLABE de 18 dígitos, banco y titular.
  clabe            String?
  clabeBank        String?
  clabeHolder      String?
  accessToken      String     @unique @default(cuid())
  referralCode     String     @unique
  active           Boolean    @default(true)
  launchBonusUsed  Boolean    @default(false)
  bubblePoints     Int        @default(0)
  createdAt        DateTime   @default(now())
  referrals        Referral[]
  bubbleClaims     BubbleClaim[]

  @@index([advisorId])
}

model BubbleClaim {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount      Int
  status      String    @default("pending") // pending | paid
  paymentNote String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([clientId])
}

model PlanEvent {
  id        String   @id @default(cuid())
  advisorId String
  advisor   Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  event     String // activated | failed | cancelled
  createdAt DateTime @default(now())

  @@index([advisorId])
  @@index([createdAt])
}

// Última narrativa generada por IA para /owner. Una sola fila vigente a la
// vez — se relee mientras no pase el intervalo de refresco y se reemplaza
// cuando toca regenerar (ver REFRESH_MS en owner-narrative-ai.ts).
model OwnerBriefing {
  id          String   @id @default(cuid())
  narrative   String
  generatedAt DateTime @default(now())
}

model Referral {
  id           String   @id @default(cuid())
  advisorId    String
  advisor      Advisor  @relation(fields: [advisorId], references: [id])
  referrerId   String
  referrer     Client   @relation(fields: [referrerId], references: [id])
  leadName     String
  leadPhone    String
  leadEmail    String?
  leadNotes    String?
  tierPosition Int
  rewardAmount Int
  status       String   @default("pending")
  rewardStatus String   @default("pending")
  saleAmount          Int?
  productType         String?
  interestProductType String?
  // Comisión de Referidoo sobre este contrato cerrado. null = no calculada
  // (referido convertido antes de que este campo existiera, o producto sin
  // tasa definida) — nunca 0, para no confundir "no aplica" con "comisión cero".
  lessioCommission    Int?
  // Cuándo se cobró esta comisión dentro de la mensualidad del asesor (cron de
  // cobro). null = todavía no se ha facturado — la suma sigue acumulándose
  // para el próximo ciclo de cobro.
  billedAt            DateTime?
  rewardPaidAt        DateTime?
  paymentNote         String?
  // Carátula de la póliza: evidencia del monto reportado (URL en Vercel Blob).
  // caratulaStatus: pendiente (subida, sin revisar) | validada | discrepancia.
  caratulaUrl         String?
  caratulaStatus      String?
  confirmedByReferrer Boolean   @default(false)
  referrerConfirmedAt DateTime?
  // Primer contacto del asesor con el lead (status → contacted por 1a vez).
  // Alimenta la métrica "horas a primer contacto" del Playbook 2.
  contactedAt         DateTime?
  // Preferencias de contacto que el lead captura en el formulario (opcionales):
  // días y franja horaria en que prefiere que lo contacten.
  preferredDays       String?
  preferredHours      String?
  // Cuándo se aprobó el premio del cliente (rewardStatus → approved por 1a vez).
  // Ancla del corte obligatorio: el asesor tiene 1 mes desde aquí para pagarlo.
  rewardApprovedAt    DateTime?
  // Soft delete: se oculta de la lista del asesor, pero el registro se
  // conserva para el rastro contable y antifraude del dueño de la
  // plataforma (nunca se borra de verdad — ver DELETE en
  // api/referrals/[id]/route.ts).
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([advisorId])
  @@index([referrerId])
  @@index([status])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Advisor {
  id          String           @id @default(cuid())
  name        String
  email       String           @unique
  password    String
  phone       String?
  companyName String?
  createdAt   DateTime         @default(now())
  clients     Client[]
  referrals   Referral[]
  tiers       RewardTier[]
  settings    AdvisorSettings?
}

model AdvisorSettings {
  id              String  @id @default(cuid())
  advisorId       String  @unique
  advisor         Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  afterLastTier   String  @default("cycle")
  flatAmount      Int     @default(1500)
  whatsappMessage String?
  welcomeMessage  String?
}

model RewardTier {
  id        String  @id @default(cuid())
  advisorId String
  advisor   Advisor @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  position  Int
  amount    Int
  label     String?

  @@unique([advisorId, position])
}

model Client {
  id               String     @id @default(cuid())
  advisorId        String
  advisor          Advisor    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  policyNumber     String?
  accessToken      String     @unique @default(cuid())
  referralCode     String     @unique
  active           Boolean    @default(true)
  launchBonusUsed  Boolean    @default(false)
  createdAt        DateTime   @default(now())
  referrals        Referral[]
}

model Referral {
  id           String   @id @default(cuid())
  advisorId    String
  advisor      Advisor  @relation(fields: [advisorId], references: [id])
  referrerId   String
  referrer     Client   @relation(fields: [referrerId], references: [id])
  leadName     String
  leadPhone    String
  leadEmail    String?
  leadNotes    String?
  tierPosition Int
  rewardAmount Int
  status       String   @default("pending")
  rewardStatus String   @default("pending")
  saleAmount          Int?
  rewardPaidAt        DateTime?
  paymentNote         String?
  confirmedByReferrer Boolean   @default(false)
  referrerConfirmedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
